---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CTA from '../components/CTA.astro';
import ProjectCard from '../components/ProjectCard.astro';

interface TechTab {
	name: string;
	description: string;
	directions: string;
	keybinds?: string[];
}

const techTabs: TechTab[] = [
	{
		name: 'Particle System',
		description: 'A custom particle canvas that reads any image or SVG and reacts to touch and clicks. Works best with no background. Built for this site, but it doesn\'t care what image you give it.',
		directions: 'Move your cursor near it, or drag with a finger. Click or tap to see it react.',
	},
];

const particlePresets = [
	{ id: 'logo', label: 'Logo', src: '/Iterate Prairie Tech Loop No BG.png' },
	{ id: 'web', label: 'Web Design', src: '/IPT - Services - Web Design.svg' },
	{ id: 'it', label: 'IT & Tech Support', src: '/IPT - Services - IT & Tech Support.svg' },
];
---

<Layout
	title="Proof"
	description="Try the tools yourself, then see them used on real client sites. Work from Iterate Prairie Tech."
	activePath="/proof"
>
	<Nav activePath="/proof" />
	<main>
		<section class="page-head section">
			<div class="container">
				<h1 class="headline" data-anim>Not a sales pitch. Just the work.</h1>
				<p class="lead" data-anim>
					Try the tools yourself below, then scroll down and see them used on real client
					sites.
				</p>
			</div>
		</section>

		<section class="section proof-section" id="technology">
			<div class="container">
				<h2 class="section-title" data-anim>Technology.</h2>
				<div class="tech-tabs" data-tech-tabs data-anim>
					<div class="tab-row" role="tablist" aria-label="Technology demos">
						{
							techTabs.map((tab, i) => (
								<button
									class:list={['tab-btn', { 'is-active': i === 0 }]}
									type="button"
									role="tab"
									id={`tech-tab-${i}`}
									aria-selected={i === 0}
									aria-controls={`tech-panel-${i}`}
									data-tab={String(i)}
								>
									{tab.name}
								</button>
							))
						}
					</div>
					{
						techTabs.map((tab, i) => (
							<div
								class="tab-panel"
								id={`tech-panel-${i}`}
								role="tabpanel"
								aria-labelledby={`tech-tab-${i}`}
								hidden={i !== 0}
								data-panel={String(i)}
							>
								<p class="tab-desc">{tab.description}</p>
								<p class="tab-directions">{tab.directions}</p>
								{tab.keybinds?.length ? (
									<ul class="tab-keys">
										{tab.keybinds.map((k) => (
											<li>{k}</li>
										))}
									</ul>
								) : null}
							</div>
						))
					}
					<div class="tab-demo" data-tech-demo>
						<div class="demo-stage">
							<canvas class="demo-canvas" data-demo-particle></canvas>
							<canvas class="demo-canvas demo-burst" data-demo-burst></canvas>
						</div>
						<div class="demo-options" data-demo-options>
							<label class="opt">
								<span class="opt__label">Density</span>
								<input type="range" min="0.5" max="2" step="0.1" value="1" data-opt="density" />
								<span class="opt__val" data-val="density">1.0x</span>
							</label>
							<label class="opt">
								<span class="opt__label">Speed</span>
								<input type="range" min="0" max="2.5" step="0.1" value="1" data-opt="speed" />
								<span class="opt__val" data-val="speed">1.0x</span>
							</label>
							<label class="opt">
								<span class="opt__label">Size</span>
								<input type="range" min="0.5" max="2.5" step="0.1" value="1" data-opt="size" />
								<span class="opt__val" data-val="size">1.0x</span>
							</label>
							<label class="opt">
								<span class="opt__label">Cursor</span>
								<input type="range" min="40" max="220" step="10" value="100" data-opt="repulsion" />
								<span class="opt__val" data-val="repulsion">100px</span>
							</label>
							<button class="opt-reset" type="button" data-opt-reset>Reset</button>
						</div>
						<div class="demo-bar" data-demo-bar>
							<div class="demo-gallery" role="group" aria-label="Shape presets">
								{
									particlePresets.map((p, i) => (
										<button
											class:list={['demo-thumb', { 'is-active': i === 0 }]}
											type="button"
											data-preset={p.src}
											aria-pressed={i === 0}
										>
											<img src={p.src} alt="" />
											<span>{p.label}</span>
										</button>
									))
								}
							</div>
							<div class="demo-tools">
								<div class="mode-toggle" role="group" aria-label="Render mode">
									<button class="mode-btn is-active" type="button" data-mode="shape" aria-pressed="true">
										Shape
									</button>
									<button class="mode-btn" type="button" data-mode="photo" aria-pressed="false">
										Photo
									</button>
								</div>
								<label class="demo-upload">
									<span>Upload</span>
									<input
										type="file"
										accept="image/png,image/jpeg,image/svg+xml,.png,.jpg,.jpeg,.svg"
										data-demo-upload
									/>
								</label>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="section proof-section" id="projects">
			<div class="container">
				<h2 class="section-title" data-anim>Projects.</h2>
				<div class="project-grid">
					<ProjectCard text="First project launching soon. In progress now.">
						<canvas slot="visual" data-project-still></canvas>
					</ProjectCard>
				</div>
			</div>
		</section>

		<CTA />
	</main>
	<Footer />
</Layout>

<style>
	.page-head {
		padding-top: calc(var(--nav-h) + 4rem);
	}

	.page-head .lead {
		margin-top: 1.25rem;
	}

	.proof-section {
		border-top: 1px solid var(--border);
	}

	.project-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.5rem;
		margin-top: 2rem;
	}

	@media (max-width: 820px) {
		.project-grid {
			grid-template-columns: 1fr;
		}
	}

	.tech-tabs {
		margin-top: 2rem;
	}

	.tab-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0 1.75rem;
		border-bottom: 1px solid var(--border);
	}

	.tab-btn {
		position: relative;
		padding: 0.7rem 0 0.85rem;
		margin: 0;
		background: none;
		border: none;
		border-radius: 0;
		color: var(--muted);
		font-family: Sora, Inter, sans-serif;
		font-size: 0.92rem;
		font-weight: 600;
		letter-spacing: 0.01em;
		cursor: pointer;
		transition: color 0.25s ease;
	}

	.tab-btn:hover {
		color: var(--text);
	}

	.tab-btn.is-active {
		color: var(--text);
	}

	.tab-btn.is-active::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: -1px;
		height: 2px;
		border-radius: 1px;
		background: var(--accent);
	}

	.tab-panel {
		padding-top: 1.5rem;
		max-width: 44rem;
	}

	.tab-desc {
		font-size: clamp(1.05rem, 1.4vw, 1.2rem);
		color: var(--muted);
		margin-bottom: 0.75rem;
	}

	.tab-directions {
		color: var(--text);
	}

	.tab-keys {
		list-style: none;
		padding: 0;
		margin: 1rem 0 0;
		display: grid;
		gap: 0.35rem;
		font-size: 0.95rem;
		color: var(--muted);
	}

	.tab-demo {
		margin-top: 2rem;
	}

	.demo-stage {
		position: relative;
		height: min(70vw, 28rem);
		border-radius: var(--radius);
		background: #2c2c2a;
		overflow: hidden;
	}

	.demo-canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		display: block;
		touch-action: none;
	}

	.demo-burst {
		pointer-events: none;
	}

	.demo-options {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem 2rem;
		margin-top: 1.25rem;
	}

	.opt {
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}

	.opt__label {
		font-family: Sora, Inter, sans-serif;
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.opt input[type='range'] {
		width: 6.5rem;
		accent-color: var(--accent);
	}

	.opt__val {
		font-family: Sora, Inter, sans-serif;
		font-size: 0.72rem;
		font-weight: 600;
		color: var(--muted);
		min-width: 2.75rem;
	}

	.opt-reset {
		margin: 0;
		background: none;
		border: none;
		border-radius: 0;
		padding: 0.35rem 0;
		color: var(--muted);
		font-family: Sora, Inter, sans-serif;
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		cursor: pointer;
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	.opt-reset:hover {
		color: var(--text);
	}

	.demo-bar {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1.25rem;
		margin-top: 1.25rem;
	}

	.demo-gallery {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.demo-thumb {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.4rem;
		padding: 0;
		margin: 0;
		background: none;
		border: none;
		border-radius: 0;
		color: var(--muted);
		font-family: Sora, Inter, sans-serif;
		font-size: 0.75rem;
		font-weight: 600;
		cursor: pointer;
	}

	.demo-thumb img {
		width: 4.5rem;
		height: 4.5rem;
		object-fit: contain;
		padding: 0.45rem;
		background: var(--bg-2);
		border-radius: 10px;
		border: 1px solid transparent;
		transition: border-color 0.25s ease;
	}

	.demo-thumb.is-active {
		color: var(--text);
	}

	.demo-thumb.is-active img {
		border-color: var(--accent);
	}

	.demo-tools {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1.25rem;
	}

	.mode-toggle {
		display: flex;
		gap: 1.25rem;
		border-bottom: 1px solid var(--border);
	}

	.mode-btn {
		position: relative;
		padding: 0.55rem 0 0.7rem;
		margin: 0;
		background: none;
		border: none;
		border-radius: 0;
		color: var(--muted);
		font-family: Sora, Inter, sans-serif;
		font-size: 0.85rem;
		font-weight: 600;
		cursor: pointer;
	}

	.mode-btn.is-active {
		color: var(--text);
	}

	.mode-btn.is-active::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: -1px;
		height: 2px;
		background: var(--accent);
	}

	.demo-upload {
		position: relative;
		color: var(--text);
		font-family: Sora, Inter, sans-serif;
		font-size: 0.85rem;
		font-weight: 600;
		cursor: pointer;
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	.demo-upload input {
		position: absolute;
		inset: 0;
		opacity: 0;
		cursor: pointer;
	}

	@media (max-width: 640px) {
		.demo-bar {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import { createParticleEngine, loadImage } from '../lib/particleEngine';
	import type { ParticleLiveOptions, SampleMode, SampleSource } from '../lib/particleEngine';

	gsap.registerPlugin(ScrollTrigger);

	const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	const tabsRoot = document.querySelector<HTMLElement>('[data-tech-tabs]');
	if (tabsRoot) {
		const buttons = Array.from(tabsRoot.querySelectorAll<HTMLButtonElement>('[data-tab]'));
		const panels = Array.from(tabsRoot.querySelectorAll<HTMLElement>('[data-panel]'));
		buttons.forEach((btn) => {
			btn.addEventListener('click', () => {
				const id = btn.dataset.tab;
				buttons.forEach((b) => {
					const on = b === btn;
					b.classList.toggle('is-active', on);
					b.setAttribute('aria-selected', String(on));
				});
				panels.forEach((p) => {
					p.hidden = p.dataset.panel !== id;
				});
			});
		});
	}

	const demoCv = document.querySelector<HTMLCanvasElement>('[data-demo-particle]');
	const demoBurst = document.querySelector<HTMLCanvasElement>('[data-demo-burst]');
	const demoBar = document.querySelector<HTMLElement>('[data-demo-bar]');
	const thumbs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-preset]'));
	const modeBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-mode]'));
	const upload = document.querySelector<HTMLInputElement>('[data-demo-upload]');

	if (prefersReduced) {
		if (demoCv) demoCv.style.display = 'none';
		if (demoBurst) demoBurst.style.display = 'none';
		if (demoBar) demoBar.hidden = true;
	} else if (demoCv) {
		let mode: SampleMode = 'shape';
		const cache = new Map<string, HTMLImageElement>();

		function pickColor(): string {
			const r = Math.random();
			if (r < 0.08) return '#38B6FF';
			if (r < 0.28) return '#FF7870';
			return '#F2EFEB';
		}

		const engine = createParticleEngine({
			canvas: demoCv,
			burstCanvas: demoBurst,
			pointerRoot: demoCv,
			touchDrag: true,
			clickBurst: true,
			pickColor,
		});

		async function applySrc(src: string, morph: boolean) {
			let im = cache.get(src);
			if (!im) {
				im = await loadImage(src);
				cache.set(src, im);
			}
			engine.sampleImage(im, mode, morph);
		}

		function applySource(source: SampleSource, morph: boolean) {
			engine.sampleImage(source, mode, morph);
		}

		function setThumb(active: HTMLButtonElement | null) {
			thumbs.forEach((t) => {
				const on = t === active;
				t.classList.toggle('is-active', on);
				t.setAttribute('aria-pressed', String(on));
			});
		}

		engine.resize();
		void applySrc('/Iterate Prairie Tech Loop No BG.png', false).then(() => engine.start());

		thumbs.forEach((btn) => {
			btn.addEventListener('click', () => {
				const src = btn.dataset.preset;
				if (!src) return;
				setThumb(btn);
				void applySrc(src, true);
			});
		});

		modeBtns.forEach((btn) => {
			btn.addEventListener('click', () => {
				const next = btn.dataset.mode as SampleMode;
				if (!next || next === mode) return;
				mode = next;
				modeBtns.forEach((b) => {
					const on = b === btn;
					b.classList.toggle('is-active', on);
					b.setAttribute('aria-pressed', String(on));
				});
				const src = engine.source;
				if (src) applySource(src, true);
			});
		});

		upload?.addEventListener('change', () => {
			const file = upload.files?.[0];
			if (!file) return;
			const url = URL.createObjectURL(file);
			void loadImage(url).then((im) => {
				setThumb(null);
				applySource(im, true);
				URL.revokeObjectURL(url);
			});
		});

		const stage = demoCv.parentElement;
		if (stage) {
			const ro = new ResizeObserver(() => {
				engine.resize();
				const src = engine.source;
				if (src) applySource(src, true);
			});
			ro.observe(stage);
		}

		type LiveKey = 'density' | 'speed' | 'size' | 'repulsion';
		const liveDefaults: Record<LiveKey, number> = { density: 1, speed: 1, size: 1, repulsion: 100 };
		const liveInputs: Record<LiveKey, HTMLInputElement | null> = {
			density: document.querySelector<HTMLInputElement>('[data-opt="density"]'),
			speed: document.querySelector<HTMLInputElement>('[data-opt="speed"]'),
			size: document.querySelector<HTMLInputElement>('[data-opt="size"]'),
			repulsion: document.querySelector<HTMLInputElement>('[data-opt="repulsion"]'),
		};

		function fmtLive(k: LiveKey, v: number): string {
			return k === 'repulsion' ? `${Math.round(v)}px` : `${v.toFixed(1)}x`;
		}

		function setLiveVal(k: LiveKey, v: number) {
			const valEl = document.querySelector(`[data-val="${k}"]`);
			if (valEl) valEl.textContent = fmtLive(k, v);
			const patch: ParticleLiveOptions = {};
			patch[k] = v;
			engine.setLive(patch);
		}

		(Object.keys(liveInputs) as LiveKey[]).forEach((k) => {
			liveInputs[k]?.addEventListener('input', () => {
				const v = parseFloat(liveInputs[k]!.value);
				if (Number.isNaN(v)) return;
				setLiveVal(k, v);
			});
		});

		document.querySelector<HTMLButtonElement>('[data-opt-reset]')?.addEventListener('click', () => {
			(Object.keys(liveDefaults) as LiveKey[]).forEach((k) => {
				const input = liveInputs[k];
				if (input) input.value = String(liveDefaults[k]);
				setLiveVal(k, liveDefaults[k]);
			});
		});

		document.addEventListener('visibilitychange', () => {
			if (document.hidden) engine.stop();
			else engine.start();
		});
	}

	const stillCv = document.querySelector<HTMLCanvasElement>('[data-project-still]');
	if (stillCv) {
		const still = createParticleEngine({
			canvas: stillCv,
			pickColor: () => {
				const r = Math.random();
				if (r < 0.08) return '#38B6FF';
				if (r < 0.28) return '#FF7870';
				return '#F2EFEB';
			},
		});
		function drawQuestionMark(): HTMLCanvasElement {
			const c = document.createElement('canvas');
			c.width = 800;
			c.height = 800;
			const g = c.getContext('2d')!;
			g.fillStyle = '#2C2C2A';
			g.textAlign = 'center';
			g.textBaseline = 'middle';
			g.font = '800 520px Sora, Inter, sans-serif';
			g.fillText('?', 400, 430);
			return c;
		}
		function paintStill() {
			still.resize();
			still.sampleImage(drawQuestionMark(), 'shape', false);
			still.drawStill();
		}
		const paint = () => paintStill();
		if (document.fonts?.status === 'loaded') paint();
		else void document.fonts?.ready.then(paint);
		const vis = stillCv.parentElement;
		if (vis) {
			const ro = new ResizeObserver(() => paintStill());
			ro.observe(vis);
		}
	}

	if (prefersReduced) {
		gsap.set('[data-anim]', { opacity: 1, clearProps: 'transform' });
	} else {
		gsap.fromTo(
			'.page-head [data-anim]',
			{ y: 24 },
			{ opacity: 1, y: 0, duration: 0.6, stagger: 0.1, ease: 'power3.out', delay: 0.15 },
		);

		gsap.utils.toArray<HTMLElement>('.proof-section [data-anim]').forEach((el) => {
			gsap.fromTo(
				el,
				{ y: 24 },
				{
					opacity: 1,
					y: 0,
					duration: 0.6,
					ease: 'power3.out',
					scrollTrigger: { trigger: el, start: 'top 85%' },
				},
			);
		});

		gsap.utils.toArray<HTMLElement>('[data-cta]').forEach((btn) => {
			const hov = gsap.timeline({ paused: true });
			hov.to(btn, { y: -3, scale: 1.02, duration: 0.25, ease: 'power2.out' });
			btn.addEventListener('mouseenter', () => hov.play());
			btn.addEventListener('mouseleave', () => hov.reverse());
		});
	}
</script>
