---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import CTA from '../../components/CTA.astro';
import LoopMark from '../../components/LoopMark.astro';
import PhotoPlaceholder from '../../components/PhotoPlaceholder.astro';

const tiers = [
	{
		name: 'Single-page site',
		price: '$650',
		desc: 'One scrolling page — perfect for a simple presence with your story, services, and contact info.',
	},
	{
		name: 'Standard multi-page',
		price: '$950',
		desc: 'Home, About, Services, Contact — the usual setup, with room to grow.',
		featured: true,
	},
];

const addons = [
	'Additional service sub-pages',
	'Image galleries',
	'Blog / news sections',
];
---

<Layout
	title="Web Development"
	description="Astro + GSAP websites hosted free on GitHub Pages. Single-page sites from $650, multi-page from $950."
	activePath="/services"
>
	<Nav activePath="/services" />
	<main>
		<section class="page-head section">
			<div class="container">
				<p class="kicker" data-anim>Service &middot; Web Development</p>
				<h1 class="headline" data-anim>Websites that load fast and last.</h1>
				<p class="lead" data-anim>
					Modern sites built with Astro and GSAP, hosted free on GitHub Pages, with DNS
					managed through Cloudflare. No bloated CMS, no surprise hosting bills, no
					thousand-dollar theme you can't edit.
				</p>
			</div>
		</section>

		<!-- Stack -->
		<section class="section stack" data-stack>
			<div class="container two-col">
				<div class="two-col__text" data-anim>
					<h2 class="section-title">The stack.</h2>
					<p>
						<strong>Astro</strong> builds static HTML by default, which means pages load fast
						and there's almost nothing to break. <strong>GSAP</strong> handles motion and
						scroll animations — the kind of polish that makes a site feel intentional, not
						templated.
					</p>
					<p>
						Hosting runs on <strong>GitHub Pages</strong>, so it's free and reliable. DNS goes
						through <strong>Cloudflare</strong>, which gives fast resolution, free SSL, and
						basic DDoS protection without extra cost.
					</p>
					<p>
						You own the code and the accounts. Nothing is locked behind a proprietary builder
						or a monthly platform fee.
					</p>
				</div>
				<div class="two-col__media" data-anim>
					<PhotoPlaceholder label="Photo placeholder — example site" ratio="4 / 3" />
				</div>
			</div>
		</section>

		<!-- Pricing -->
		<section class="section pricing" data-pricing>
			<div class="container">
				<div class="pricing-head" data-anim>
					<h2 class="section-title">Pricing.</h2>
					<p class="lead">Straightforward starting points. Add-ons priced per project.</p>
				</div>
				<div class="tiers">
					{
						tiers.map((t) => (
							<article class:list={['tier', { 'is-featured': t.featured }]} data-anim data-tier>
								<h3>{t.name}</h3>
								<p class="tier-price">{t.price}</p>
								<p class="tier-desc">{t.desc}</p>
							</article>
						))
					}
				</div>

				<div class="addons" data-anim>
					<h3>Add-ons available</h3>
					<ul>
						{addons.map((a) => <li>{a}</li>)}
					</ul>
					<p class="addons-note">Priced per project — just describe what you need and you'll get a clear quote.</p>
				</div>
			</div>
		</section>

		<!-- Loop divider -->
		<div class="loop-divider" data-anim>
			<LoopMark size={144} />
		</div>

		<CTA title="Ready to start a site?" text="Tell us what you're building and we'll map out the pages and the price." />
	</main>
	<Footer />
</Layout>

<style>
	.page-head {
		padding-top: calc(var(--nav-h) + 4rem);
	}

	.page-head .lead {
		margin-top: 1.25rem;
	}

	.stack {
		background: var(--bg-2);
	}

	.two-col {
		display: grid;
		grid-template-columns: 1.1fr 0.9fr;
		gap: 3rem;
		align-items: center;
	}

	.two-col__text p + p {
		margin-top: 1.1rem;
	}

	.two-col__text strong {
		color: var(--accent);
	}

	.pricing-head {
		max-width: 44rem;
		margin-bottom: 2.5rem;
	}

	.tiers {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.25rem;
		margin-bottom: 2.5rem;
	}

	.tier {
		padding: 2rem;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
	}

	.tier.is-featured {
		border-color: var(--accent);
		box-shadow: 0 12px 32px -16px rgba(255, 120, 112, 0.5);
	}

	.tier h3 {
		font-size: 1.2rem;
		text-transform: uppercase;
		margin-bottom: 0.5rem;
	}

	.tier-price {
		font-family: Sora, Inter, sans-serif;
		font-weight: 800;
		font-size: 2rem;
		color: var(--accent);
		margin-bottom: 0.75rem;
	}

	.tier-desc {
		color: var(--muted);
	}

	.addons {
		padding: 2rem;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
	}

	.addons h3 {
		font-size: 1.1rem;
		text-transform: uppercase;
		margin-bottom: 1rem;
	}

	.addons ul {
		list-style: none;
		padding: 0;
		margin: 0 0 1rem;
		display: grid;
		gap: 0.5rem;
	}

	.addons li {
		position: relative;
		padding-left: 1.5rem;
	}

	.addons li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.55em;
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--accent-grad);
	}

	.addons-note {
		color: var(--muted);
		font-size: 0.9rem;
	}

	.loop-divider {
		display: flex;
		justify-content: center;
		padding: 1.5rem 0;
	}

	@media (max-width: 820px) {
		.two-col {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
		.tiers {
			grid-template-columns: 1fr;
		}
	}
</style>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (prefersReduced) {
		gsap.set('[data-anim]', { opacity: 1, clearProps: 'transform' });
	} else {
		gsap.fromTo('[data-stack] [data-anim]', { y: 24 }, {
			opacity: 1, y: 0, duration: 0.6, stagger: 0.12, ease: 'power3.out',
			scrollTrigger: { trigger: '[data-stack]', start: 'top 80%' },
		});

		gsap.fromTo('[data-pricing] .pricing-head', { y: 20 }, {
			opacity: 1, y: 0, duration: 0.6, scrollTrigger: { trigger: '[data-pricing]', start: 'top 80%' },
		});

		const tiers = gsap.utils.toArray<HTMLElement>('[data-tier]');
		gsap.fromTo(tiers, { y: 30 }, {
			opacity: 1, y: 0, duration: 0.6, stagger: 0.1, ease: 'power3.out',
			scrollTrigger: { trigger: '[data-pricing] .tiers', start: 'top 82%' },
		});

		gsap.fromTo('[data-pricing] .addons', { y: 26 }, {
			opacity: 1, y: 0, duration: 0.6, scrollTrigger: { trigger: '[data-pricing] .addons', start: 'top 85%' },
		});

		gsap.utils.toArray<HTMLElement>('[data-cta]').forEach((btn) => {
			const hov = gsap.timeline({ paused: true });
			hov.to(btn, { y: -3, scale: 1.02, duration: 0.25, ease: 'power2.out' });
			btn.addEventListener('mouseenter', () => hov.play());
			btn.addEventListener('mouseleave', () => hov.reverse());
		});
	}
</script>
