---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import CTA from '../../components/CTA.astro';
import PhotoPlaceholder from '../../components/PhotoPlaceholder.astro';

const options = [
	{
		name: 'On-site',
		price: '$65/hr',
		min: '1-hour minimum',
		desc: 'In-person support at your location around Breckenridge and the surrounding area. Best for hardware, networking, and anything hands-on.',
	},
	{
		name: 'Remote',
		price: '$50/hr',
		min: '30-minute minimum',
		desc: 'Screen-share and phone support for software issues, configuration, and anything that doesn\'t need a drive over.',
		featured: true,
	},
];

const scope = [
	'Device troubleshooting (PCs, laptops, printers)',
	'Network setup & Wi-Fi issues',
	'Software installation & configuration',
	'Email setup and problems',
	'General "my computer is acting weird" help',
];
---

<Layout
	title="IT & Tech Support"
	description="On-site and remote IT support for small businesses around Breckenridge, MN. $65/hr on-site, $50/hr remote."
	activePath="/services"
>
	<Nav activePath="/services" />
	<main>
		<section class="page-head section">
			<div class="container">
				<p class="kicker" data-anim>Service &middot; IT &amp; Tech Support</p>
				<h1 class="headline" data-anim>Tech help that actually shows up.</h1>
				<p class="lead" data-anim>
					General device, network, and software troubleshooting for small businesses. Whether
					it's a printer that won't connect or a network that keeps dropping, the fix doesn't
					have to mean a two-hour drive to Fargo.
				</p>
			</div>
		</section>

		<!-- How it works -->
		<section class="section how" data-how>
			<div class="container two-col">
				<div class="two-col__text" data-anim>
					<h2 class="section-title">How it works.</h2>
					<p>
						Pay-as-you-go is the default. You call when something's wrong, we sort it out, and
						you pay for the time it actually took. No retainer, no minimum commitment, no
						sign-up form.
					</p>
					<p>
						On-site visits come to you around Breckenridge and the surrounding area. Remote
						support covers anything we can fix over a screen share and a phone call — usually
						faster to schedule, and it's a lower rate.
					</p>
					<p>
						If you find yourself calling every month, there's an optional
						<strong>$90/month plan</strong> that covers routine support and priority
						scheduling. It's there if you want it — but most people start pay-as-you-go and
						stay there.
					</p>
				</div>
				<div class="two-col__media" data-anim>
					<PhotoPlaceholder label="Photo placeholder — on-site support" ratio="4 / 3" />
				</div>
			</div>
		</section>

		<!-- Pricing -->
		<section class="section pricing" data-pricing>
			<div class="container">
				<div class="pricing-head" data-anim>
					<h2 class="section-title">Rates.</h2>
					<p class="lead">Pay-as-you-go. No retainer required.</p>
				</div>
				<div class="tiers">
					{
						options.map((o) => (
							<article class:list={['tier', { 'is-featured': o.featured }]} data-anim data-tier>
								<h3>{o.name}</h3>
								<p class="tier-price">{o.price}</p>
								<p class="tier-min">{o.min}</p>
								<p class="tier-desc">{o.desc}</p>
							</article>
						))
					}
				</div>

				<div class="scope" data-anim>
					<h3>Typical scope</h3>
					<ul>
						{scope.map((s) => <li>{s}</li>)}
					</ul>
					<p class="scope-note">If it's not on the list, just ask — if it's tech and it's for a small business, it probably fits.</p>
				</div>
			</div>
		</section>

		<CTA title="Something not working?" text="Call or email and we'll figure out whether it's an on-site visit or a quick remote fix." />
	</main>
	<Footer />
</Layout>

<style>
	.page-head {
		padding-top: calc(var(--nav-h) + 4rem);
	}

	.page-head .lead {
		margin-top: 1.25rem;
	}

	.how {
		background: var(--bg-2);
	}

	.two-col {
		display: grid;
		grid-template-columns: 1.1fr 0.9fr;
		gap: 3rem;
		align-items: center;
	}

	.two-col__text p + p {
		margin-top: 1.1rem;
	}

	.two-col__text strong {
		color: var(--accent);
	}

	.pricing-head {
		max-width: 44rem;
		margin-bottom: 2.5rem;
	}

	.tiers {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.25rem;
		margin-bottom: 2.5rem;
	}

	.tier {
		padding: 2rem;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
	}

	.tier.is-featured {
		border-color: var(--accent);
		box-shadow: 0 12px 32px -16px rgba(255, 120, 112, 0.5);
	}

	.tier h3 {
		font-size: 1.2rem;
		text-transform: uppercase;
		margin-bottom: 0.5rem;
	}

	.tier-price {
		font-family: Sora, Inter, sans-serif;
		font-weight: 800;
		font-size: 2rem;
		color: var(--accent);
		margin-bottom: 0.25rem;
	}

	.tier-min {
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--muted);
		margin-bottom: 0.85rem;
	}

	.tier-desc {
		color: var(--muted);
	}

	.scope {
		padding: 2rem;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
	}

	.scope h3 {
		font-size: 1.1rem;
		text-transform: uppercase;
		margin-bottom: 1rem;
	}

	.scope ul {
		list-style: none;
		padding: 0;
		margin: 0 0 1rem;
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 0.5rem;
	}

	.scope li {
		position: relative;
		padding-left: 1.5rem;
		font-size: 0.95rem;
	}

	.scope li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.55em;
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--accent-grad);
	}

	.scope-note {
		color: var(--muted);
		font-size: 0.9rem;
	}

	@media (max-width: 820px) {
		.two-col {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
		.tiers {
			grid-template-columns: 1fr;
		}
		.scope ul {
			grid-template-columns: 1fr;
		}
	}
</style>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (prefersReduced) {
		gsap.set('[data-anim]', { opacity: 1, clearProps: 'transform' });
	} else {
		gsap.fromTo('[data-how] [data-anim]', { y: 24 }, {
			opacity: 1, y: 0, duration: 0.6, stagger: 0.12, ease: 'power3.out',
			scrollTrigger: { trigger: '[data-how]', start: 'top 80%' },
		});

		gsap.fromTo('[data-pricing] .pricing-head', { y: 20 }, {
			opacity: 1, y: 0, duration: 0.6, scrollTrigger: { trigger: '[data-pricing]', start: 'top 80%' },
		});

		const tiers = gsap.utils.toArray<HTMLElement>('[data-tier]');
		gsap.fromTo(tiers, { y: 30 }, {
			opacity: 1, y: 0, duration: 0.6, stagger: 0.1, ease: 'power3.out',
			scrollTrigger: { trigger: '[data-pricing] .tiers', start: 'top 82%' },
		});

		gsap.fromTo('[data-pricing] .scope', { y: 26 }, {
			opacity: 1, y: 0, duration: 0.6, scrollTrigger: { trigger: '[data-pricing] .scope', start: 'top 85%' },
		});

		gsap.utils.toArray<HTMLElement>('[data-cta]').forEach((btn) => {
			const hov = gsap.timeline({ paused: true });
			hov.to(btn, { y: -3, scale: 1.02, duration: 0.25, ease: 'power2.out' });
			btn.addEventListener('mouseenter', () => hov.play());
			btn.addEventListener('mouseleave', () => hov.reverse());
		});
	}
</script>
