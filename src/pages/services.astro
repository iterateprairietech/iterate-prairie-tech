---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CTA from '../components/CTA.astro';
import PhotoPlaceholder from '../components/PhotoPlaceholder.astro';

const services = [
	{
		href: '/services/web-development',
		title: 'Web Development',
		desc: 'Astro + GSAP websites hosted free on GitHub Pages, with DNS through Cloudflare. Fast, modern, and built to be watched and tuned over time.',
		price: 'from $650',
		points: ['Single-page or multi-page', 'Free hosting', 'Motion & smooth scroll included', 'Built to iterate'],
	},
	{
		href: '/services/it-tech-support',
		title: 'IT & Tech Support',
		desc: 'General device, network, and software troubleshooting for small businesses. On-site around Breckenridge or remote, pay-as-you-go by default.',
		price: 'from $50/hr',
		points: ['On-site or remote', 'Pay-as-you-go', '1-hour / 30-minute minimums', 'Optional monthly plan'],
	},
];
---

<Layout
	title="Services"
	description="Web development and IT & tech support for small businesses around Breckenridge, MN."
	activePath="/services"
>
	<Nav activePath="/services" />
	<main>
		<section class="page-head section">
			<div class="container">
				<h1 class="headline" data-anim>Websites &amp; tech help.</h1>
				<p class="lead" data-anim>
					Two services, done well. Pick the one you need, or use both. A lot of small
					businesses end up wanting both.
				</p>
			</div>
		</section>

		<section class="section services-index" data-services-index>
			<div class="container">
				<div class="grid">
					{
						services.map((s) => (
							<article class="svc-card" data-anim data-card>
								<div class="svc-card__media">
									<PhotoPlaceholder label={`Photo placeholder: ${s.title}`} ratio="16 / 9" />
								</div>
								<div class="svc-card__body">
									<div class="svc-card__top">
										<h2>{s.title}</h2>
										<span class="price">{s.price}</span>
									</div>
									<p>{s.desc}</p>
									<ul>
										{s.points.map((p) => <li>{p}</li>)}
									</ul>
									<a class="btn btn-primary" href={s.href} data-cta>
										View {s.title}
									</a>
								</div>
							</article>
						))
					}
				</div>
			</div>
		</section>

		<CTA />
	</main>
	<Footer />
</Layout>

<style>
	.page-head {
		padding-top: calc(var(--nav-h) + 4rem);
	}

	.page-head .lead {
		margin-top: 1.25rem;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.5rem;
	}

	.svc-card {
		display: flex;
		flex-direction: column;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		overflow: hidden;
	}

	.svc-card__media {
		border-bottom: 1px solid var(--border);
	}

	.svc-card__body {
		display: flex;
		flex-direction: column;
		padding: 2rem;
		flex: 1;
	}

	.svc-card__top {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.85rem;
	}

	.svc-card h2 {
		font-size: 1.5rem;
		text-transform: uppercase;
	}

	.price {
		font-family: Sora, Inter, sans-serif;
		font-weight: 700;
		font-size: 0.92rem;
		color: var(--accent);
		white-space: nowrap;
	}

	.svc-card p {
		color: var(--muted);
		margin-bottom: 1.25rem;
	}

	.svc-card ul {
		list-style: none;
		padding: 0;
		margin: 0 0 1.75rem;
		display: grid;
		gap: 0.5rem;
	}

	.svc-card li {
		position: relative;
		padding-left: 1.5rem;
		font-size: 0.95rem;
	}

	.svc-card li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.55em;
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--accent-grad);
	}

	.svc-card .btn {
		align-self: flex-start;
	}

	@media (max-width: 820px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (prefersReduced) {
		gsap.set('[data-anim]', { opacity: 1, clearProps: 'transform' });
	} else {
		gsap.fromTo(
			'.page-head [data-anim]',
			{ y: 24 },
			{ opacity: 1, y: 0, duration: 0.6, stagger: 0.1, ease: 'power3.out', delay: 0.15 },
		);

		const cards = gsap.utils.toArray<HTMLElement>('[data-services-index] [data-card]');
		gsap.fromTo(
			cards,
			{ y: 34 },
			{ opacity: 1, y: 0, duration: 0.6, stagger: 0.12, ease: 'power3.out', scrollTrigger: { trigger: '[data-services-index] .grid', start: 'top 82%' } },
		);

		gsap.utils.toArray<HTMLElement>('[data-cta]').forEach((btn) => {
			const hov = gsap.timeline({ paused: true });
			hov.to(btn, { y: -3, scale: 1.02, duration: 0.25, ease: 'power2.out' });
			btn.addEventListener('mouseenter', () => hov.play());
			btn.addEventListener('mouseleave', () => hov.reverse());
		});
	}
</script>
