---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CTA from '../components/CTA.astro';
import PhotoPlaceholder from '../components/PhotoPlaceholder.astro';

const groups = [
	{
		title: 'Web design',
		steps: [
			{ n: '01', d: 'Launch with real analytics in place' },
			{ n: '02', d: 'Scheduled review, 30 days out, then quarterly' },
			{ n: '03', d: 'Specific, priced changes, based on what\u2019s actually happening' },
		],
	},
	{
		title: 'Tech support',
		steps: [
			{ n: '01', d: 'Fix it right the first time' },
			{ n: '02', d: 'Follow-up a few days later, to confirm it held' },
			{ n: '03', d: 'Capacity kept capped on purpose, so follow-up stays realistic' },
		],
	},
];
---

<Layout
	title="About"
	description="Iterate Prairie Tech is a solo, small-town web and IT operation that sticks around after the site or the fix ships."
	activePath="/about"
>
	<Nav activePath="/about" />
	<main>
		<!-- Page header -->
		<section class="page-head section">
			<div class="container">
				<h1 class="headline" data-anim>A solo shop, built to follow through.</h1>
				<p class="lead" data-anim>
					Iterate Prairie Tech is a one-person, small-town web and IT operation. No account
					managers and no handoff deck. I build it and stick around after launch.
				</p>
			</div>
		</section>

		<!-- Mission -->
		<section class="section mission" data-mission>
			<div class="container two-col">
				<div class="two-col__text" data-anim>
					<h2 class="section-title">The idea behind it.</h2>
					<p>
						Most web and tech help follows the same pattern: someone shows up, does the thing,
						gets paid, and leaves. If something breaks six weeks later, you're starting over
						from zero, again.
					</p>
					<p>
						I don't work that way, but the two sides of this business follow through in
						different ways, because they're different kinds of work.
					</p>
					<p>
						A website isn't done the day it launches. Real analytics go in from day one, and I
						come back on a set schedule, 30 days out, then quarterly, to look at what's
						actually happening and bring specific, priced recommendations, not a vague
						check-in.
					</p>
					<p>
						Tech support is a relationship. Every fix gets a follow-up to make sure it actually
						held, and the client list stays small enough that follow-up is realistic instead of
						a promise I can't keep.
					</p>
				</div>
				<div class="two-col__media" data-anim>
					<PhotoPlaceholder label="Photo placeholder" ratio="3 / 4" />
				</div>
			</div>
		</section>

		<!-- Follow-through explained -->
		<section class="section" data-follow-steps>
			<div class="container">
				<div class="follow-head" data-anim>
					<h2 class="section-title">How each side follows through.</h2>
					<p class="lead">A different kind of follow-through for a different kind of work.</p>
				</div>
				<div class="groups">
					{
						groups.map((g) => (
							<div class="group" data-anim data-group>
								<h3>{g.title}</h3>
								<ol>
									{g.steps.map((s) => (
										<li>
											<span class="group__n">{s.n}</span>
											<span>{s.d}</span>
										</li>
									))}
								</ol>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<CTA title="Want to work this way?" text="If this sounds like how you'd want your project or your support handled, let's talk." />
	</main>
	<Footer />
</Layout>

<style>
	.page-head {
		padding-top: calc(var(--nav-h) + 4rem);
	}

	.page-head .lead {
		margin-top: 1.25rem;
	}

	.mission {
		background: var(--bg-2);
	}

	.two-col {
		display: grid;
		grid-template-columns: 1.1fr 0.9fr;
		gap: 3rem;
		align-items: center;
	}

	.two-col__text p + p {
		margin-top: 1.1rem;
	}

	.follow-head {
		max-width: 44rem;
		margin-bottom: 3rem;
	}

	.groups {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.25rem;
	}

	.group {
		padding: 2rem;
		background: var(--bg-2);
		border: none;
		border-radius: var(--radius);
		border-top: 3px solid var(--accent);
	}

	.group:nth-child(2) {
		border-top-color: var(--sky);
	}

	.group h3 {
		font-size: 1.15rem;
		text-transform: uppercase;
		margin-bottom: 1.25rem;
	}

	.group ol {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 1rem;
	}

	.group li {
		display: flex;
		align-items: baseline;
		gap: 0.9rem;
		color: var(--muted);
		font-size: 0.98rem;
	}

	.group__n {
		font-family: Sora, Inter, sans-serif;
		font-weight: 800;
		font-size: 0.9rem;
		color: var(--accent);
		flex: none;
	}

	@media (max-width: 820px) {
		.two-col {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.groups {
			grid-template-columns: 1fr;
		}
	}
</style>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (prefersReduced) {
		gsap.set('[data-anim]', { opacity: 1, clearProps: 'transform' });
	} else {
		gsap.fromTo('.page-head [data-anim]', { y: 24 }, {
			opacity: 1, y: 0, duration: 0.6, stagger: 0.1, ease: 'power3.out', delay: 0.15,
		});

		gsap.fromTo('[data-mission] [data-anim]', { y: 24 }, {
			opacity: 1, y: 0, duration: 0.6, stagger: 0.12, ease: 'power3.out',
			scrollTrigger: { trigger: '[data-mission]', start: 'top 80%' },
		});

		gsap.fromTo('[data-follow-steps] .follow-head', { y: 20 }, {
			opacity: 1, y: 0, duration: 0.6, scrollTrigger: { trigger: '[data-follow-steps]', start: 'top 80%' },
		});

		const groups = gsap.utils.toArray<HTMLElement>('[data-group]');
		gsap.fromTo(groups, { y: 30 }, {
			opacity: 1, y: 0, duration: 0.6, stagger: 0.12, ease: 'power3.out',
			scrollTrigger: { trigger: '[data-follow-steps] .groups', start: 'top 82%' },
		});
	}
</script>
