---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CTA from '../components/CTA.astro';
import LoopMark from '../components/LoopMark.astro';
import PhotoPlaceholder from '../components/PhotoPlaceholder.astro';

const steps = [
	{ n: '01', t: 'Test', d: 'Ship something small, turn it on, and watch what actually happens in the real world.' },
	{ n: '02', t: 'Analyze', d: 'Look at the data, the feedback, and the behavior. What worked, what stalled, what surprised us.' },
	{ n: '03', t: 'Adjust', d: 'Change the thing that needs changing — the layout, the copy, the setting, the setup.' },
	{ n: '04', t: 'Repeat', d: 'Do it again. And again. Small steady improvements beat one big launch, every time.' },
];
---

<Layout
	title="About"
	description="Iterate Prairie Tech is a solo, small-town web and IT operation built on a simple loop: test, analyze, adjust, repeat."
	activePath="/about"
>
	<Nav activePath="/about" />
	<main>
		<!-- Page header -->
		<section class="page-head section">
			<div class="container">
				<p class="kicker" data-anim>About</p>
				<h1 class="headline" data-anim>A solo shop built on a loop.</h1>
				<p class="lead" data-anim>
					Iterate Prairie Tech is a one-person, small-town web and IT operation. No account
					managers, no handoff deck, no vanishing act after launch — just one person who builds
					it, watches it, and adjusts it based on what's actually happening.
				</p>
			</div>
		</section>

		<!-- Mission -->
		<section class="section mission" data-mission>
			<div class="container two-col">
				<div class="two-col__text" data-anim>
					<h2 class="section-title">The idea behind it.</h2>
					<p>
						Most web and tech help follows the same pattern: someone shows up, does the thing,
						gets paid, and leaves. If something breaks six weeks later, you start over from
						zero — again.
					</p>
					<p>
						Iterate Prairie Tech is built differently. The whole operation runs on one simple
						loop: <strong>test, analyze, adjust, repeat.</strong> Every project — a website, a
						network fix, a recurring support plan — gets built, watched, and tuned over time
						based on real behavior, not a one-time snapshot.
					</p>
					<p>
						That doesn't mean endless billing. It means the work doesn't stop being your work
						the day it ships. Things change. Traffic changes. Devices change. The loop is how
						the work keeps up.
					</p>
				</div>
				<div class="two-col__media" data-anim>
					<PhotoPlaceholder label="Photo placeholder" ratio="3 / 4" />
				</div>
			</div>
		</section>

		<!-- Tagline band with loop motif -->
		<section class="tagline-band" data-tagline-band>
			<div class="container tagline-inner" data-anim>
				<LoopMark size={168} />
				<p class="big-tagline">Test. Analyze. Adjust. Repeat.</p>
				<p class="tagline-sub">
					Four steps, done over and over, on every project. It's not a slogan — it's the actual workflow.
				</p>
			</div>
		</section>

		<!-- The loop explained -->
		<section class="section" data-loop-steps>
			<div class="container">
				<div class="loop-head" data-anim>
					<h2 class="section-title">How the loop works.</h2>
					<p class="lead">Same four steps, every time, on every project.</p>
				</div>
				<div class="steps">
					{
						steps.map((s) => (
							<article class="step" data-anim data-step>
								<span class="step__n">{s.n}</span>
								<h3>{s.t}</h3>
								<p>{s.d}</p>
							</article>
						))
					}
				</div>
			</div>
		</section>

		<CTA title="Want to work this way?" text="If the loop sounds like how you'd want your project handled, let's talk." />
	</main>
	<Footer />
</Layout>

<style>
	.page-head {
		padding-top: calc(var(--nav-h) + 4rem);
	}

	.page-head .lead {
		margin-top: 1.25rem;
	}

	.mission {
		background: var(--bg-2);
	}

	.two-col {
		display: grid;
		grid-template-columns: 1.1fr 0.9fr;
		gap: 3rem;
		align-items: center;
	}

	.two-col__text p + p {
		margin-top: 1.1rem;
	}

	.two-col__text strong {
		color: var(--accent);
	}

	.tagline-band {
		padding: 5rem 0;
	}

	.tagline-inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 1.5rem;
	}

	.big-tagline {
		font-family: Sora, Inter, sans-serif;
		font-weight: 800;
		font-size: clamp(1.8rem, 4.5vw, 3.2rem);
		text-transform: uppercase;
		letter-spacing: -0.01em;
		line-height: 1.1;
	}

	.tagline-sub {
		color: var(--muted);
		max-width: 32rem;
	}

	.loop-head {
		max-width: 44rem;
		margin-bottom: 3rem;
	}

	.steps {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1.25rem;
	}

	.step {
		padding: 1.75rem;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
	}

	.step__n {
		display: inline-block;
		font-family: Sora, Inter, sans-serif;
		font-weight: 800;
		font-size: 0.95rem;
		color: var(--accent);
		margin-bottom: 0.75rem;
	}

	.step h3 {
		font-size: 1.15rem;
		text-transform: uppercase;
		margin-bottom: 0.5rem;
	}

	.step p {
		color: var(--muted);
		font-size: 0.95rem;
	}

	@media (max-width: 900px) {
		.steps {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 820px) {
		.two-col {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
	}

	@media (max-width: 560px) {
		.steps {
			grid-template-columns: 1fr;
		}
	}
</style>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (prefersReduced) {
		gsap.set('[data-anim]', { opacity: 1, clearProps: 'transform' });
	} else {
		gsap.fromTo('[data-mission] [data-anim]', { y: 24 }, {
			opacity: 1, y: 0, duration: 0.6, stagger: 0.12, ease: 'power3.out',
			scrollTrigger: { trigger: '[data-mission]', start: 'top 80%' },
		});

		gsap.fromTo('[data-tagline-band] .tagline-inner', { y: 28 }, {
			opacity: 1, y: 0, duration: 0.8, ease: 'power3.out',
			scrollTrigger: { trigger: '[data-tagline-band]', start: 'top 82%' },
		});

		gsap.fromTo('[data-loop-steps] .loop-head', { y: 20 }, {
			opacity: 1, y: 0, duration: 0.6, scrollTrigger: { trigger: '[data-loop-steps]', start: 'top 80%' },
		});

		const steps = gsap.utils.toArray<HTMLElement>('[data-step]');
		gsap.fromTo(steps, { y: 30 }, {
			opacity: 1, y: 0, duration: 0.6, stagger: 0.1, ease: 'power3.out',
			scrollTrigger: { trigger: '[data-loop-steps] .steps', start: 'top 82%' },
		});
	}
</script>
