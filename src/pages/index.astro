---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import CTA from '../components/CTA.astro';
import LoopMark from '../components/LoopMark.astro';
import PhotoPlaceholder from '../components/PhotoPlaceholder.astro';

const services = [
	{
		href: '/services/web-development',
		title: 'Web Development',
		desc: 'Fast, modern Astro sites with motion baked in. Hosted free on GitHub Pages, DNS through Cloudflare.',
		price: 'from $650',
	},
	{
		href: '/services/it-tech-support',
		title: 'IT & Tech Support',
		desc: 'Device, network, and software troubleshooting for small businesses. On-site or remote.',
		price: 'from $50/hr',
	},
];
---

<Layout activePath="/">
	<Nav activePath="/" />
	<main>
		<Hero />

		<!-- Services preview -->
		<section id="services-preview" class="section" data-services-preview>
			<div class="container">
				<div class="preview-head" data-anim>
					<p class="kicker">What we do</p>
					<h2 class="section-title">Two ways we help.</h2>
					<p class="lead">
						Websites that load fast and don't break, and tech support that actually shows up.
						Pick a lane, or use both.
					</p>
				</div>

				<div class="grid">
					{
						services.map((s) => (
							<a class="service-card" href={s.href} data-anim data-card>
								<div class="service-card__top">
									<h3>{s.title}</h3>
									<span class="price">{s.price}</span>
								</div>
								<p>{s.desc}</p>
								<span class="service-card__link">Learn more <span aria-hidden="true">&rarr;</span></span>
							</a>
						))
					}
				</div>
			</div>
		</section>

		<!-- About teaser -->
		<section class="section about-teaser" data-about-teaser>
			<div class="container two-col">
				<div class="two-col__text" data-anim>
					<p class="kicker">Who we are</p>
					<h2 class="section-title">A solo shop that doesn't ship and forget.</h2>
					<p class="lead">
						Iterate Prairie Tech is a one-person, small-town web and IT operation built around a
						simple loop: test, analyze, adjust, repeat. Every project gets built, watched, and
						tuned based on what's actually happening — not handed off and abandoned.
					</p>
					<a class="btn btn-ghost" href="/about" data-cta>More about the approach</a>
				</div>
				<div class="two-col__media" data-anim>
					<PhotoPlaceholder label="Photo placeholder" ratio="4 / 3" />
				</div>
			</div>
		</section>

		<!-- Loop divider -->
		<div class="loop-divider" data-anim data-loop-divider>
			<LoopMark size={144} />
		</div>

		<CTA />
	</main>
	<Footer />
</Layout>

<style>
	.preview-head {
		max-width: 46rem;
		margin-bottom: 3rem;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.25rem;
	}

	.service-card {
		display: flex;
		flex-direction: column;
		padding: 2rem;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		color: var(--text);
		will-change: transform;
	}

	.service-card__top {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.75rem;
	}

	.service-card h3 {
		font-size: 1.25rem;
		text-transform: uppercase;
	}

	.price {
		font-family: Sora, Inter, sans-serif;
		font-weight: 700;
		font-size: 0.9rem;
		color: var(--accent);
		white-space: nowrap;
	}

	.service-card p {
		color: var(--muted);
		flex: 1;
		margin-bottom: 1.25rem;
	}

	.service-card__link {
		font-family: Sora, Inter, sans-serif;
		font-weight: 600;
		font-size: 0.9rem;
		color: var(--sky);
	}

	.about-teaser {
		background: var(--bg-2);
	}

	.two-col {
		display: grid;
		grid-template-columns: 1.1fr 0.9fr;
		gap: 3rem;
		align-items: center;
	}

	.two-col__text .lead {
		margin-bottom: 1.75rem;
	}

	.loop-divider {
		display: flex;
		justify-content: center;
		padding: 2rem 0;
	}

	@media (max-width: 820px) {
		.grid {
			grid-template-columns: 1fr;
		}

		.two-col {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
	}
</style>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (prefersReduced) {
		gsap.set('[data-anim]', { opacity: 1, clearProps: 'transform' });
	} else {
		gsap.fromTo('[data-services-preview] .preview-head', { y: 20 }, { opacity: 1, y: 0, duration: 0.6, scrollTrigger: { trigger: '[data-services-preview]', start: 'top 80%' } });

		const cards = gsap.utils.toArray<HTMLElement>('[data-services-preview] [data-card]');
		gsap.fromTo(
			cards,
			{ y: 32 },
			{ opacity: 1, y: 0, duration: 0.6, stagger: 0.1, ease: 'power3.out', scrollTrigger: { trigger: '[data-services-preview] .grid', start: 'top 82%' } },
		);

		cards.forEach((card) => {
			const hov = gsap.timeline({ paused: true });
			hov.to(card, { y: -6, duration: 0.3, ease: 'power2.out' });
			card.addEventListener('mouseenter', () => {
				card.style.borderColor = 'rgba(255, 120, 112, 0.5)';
				hov.play();
			});
			card.addEventListener('mouseleave', () => {
				card.style.borderColor = '';
				hov.reverse();
			});
		});

		const teaser = gsap.utils.toArray<HTMLElement>('[data-about-teaser] [data-anim]');
		gsap.fromTo(
			teaser,
			{ y: 24 },
			{ opacity: 1, y: 0, duration: 0.6, stagger: 0.12, ease: 'power3.out', scrollTrigger: { trigger: '[data-about-teaser]', start: 'top 80%' } },
		);

		gsap.utils.toArray<HTMLElement>('[data-cta]').forEach((btn) => {
			const hov = gsap.timeline({ paused: true });
			hov.to(btn, { y: -3, scale: 1.02, duration: 0.25, ease: 'power2.out' });
			btn.addEventListener('mouseenter', () => hov.play());
			btn.addEventListener('mouseleave', () => hov.reverse());
		});
	}
</script>
