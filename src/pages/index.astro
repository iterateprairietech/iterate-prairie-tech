---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import CTA from '../components/CTA.astro';
---

<Layout activePath="/">
	<Nav activePath="/" />
	<main>
		<Hero />

		<section id="services-preview" class="section split" data-services-preview data-particle-capability>
			<div class="container split-grid split-grid--text-right">
				<div class="split-open" aria-hidden="true"></div>
				<div class="split-text" data-anim>
					<p class="kicker">What I do</p>
					<h2 class="section-title">Two ways I help.</h2>
					<p class="lead">
						Fast, modern websites that don't break, and tech support that actually picks up the
						phone. Astro sites hosted free on GitHub Pages, DNS through Cloudflare, plus
						device, network, and software troubleshooting for small businesses, on-site or
						remote. Pick one, or use both.
					</p>
					<a class="btn btn-ghost" href="/services" data-cta>See services</a>
				</div>
			</div>
		</section>

		<section class="section split" data-about-teaser data-particle-proof>
			<div class="container split-grid split-grid--text-left">
				<div class="split-text" data-anim>
					<p class="kicker">How I build</p>
					<h2 class="section-title">Websites that load fast and last.</h2>
					<p class="lead">
						Modern sites built with Astro and GSAP, hosted free on GitHub Pages, with DNS
						managed through Cloudflare. No bloated CMS, no surprise hosting bills, no
						thousand-dollar theme you can't edit. You own the code and the accounts.
					</p>
					<a class="btn btn-ghost" href="/services/web-development" data-cta>View web development</a>
				</div>
				<div class="split-open" aria-hidden="true"></div>
			</div>
		</section>

		<section class="section split" data-particle-reliability>
			<div class="container split-grid split-grid--text-right">
				<div class="split-open" aria-hidden="true"></div>
				<div class="split-text" data-anim>
					<p class="kicker">How I work</p>
					<h2 class="section-title">A solo shop that follows through.</h2>
					<p class="lead">
						Most web and tech help follows the same pattern: someone shows up, does the thing,
						gets paid, and leaves. I don't work that way. Every website gets watched after
						launch with real data, and gets specific, scheduled updates based on what's
						actually happening, not a guess. Every tech support fix gets a follow-up to make
						sure it actually held. Because it's just me, my client list stays small enough
						that both of those things are still possible.
					</p>
					<a class="btn btn-ghost" href="/about" data-cta>More about the approach</a>
				</div>
			</div>
		</section>

		<CTA />
	</main>
	<Footer />
</Layout>

<style>
	.split-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3rem;
		align-items: center;
		min-height: min(72vh, 40rem);
	}

	/* Push text away from the center line toward the outer edge,
	   and cap its width so the open half stays clearly open. */
	.split-text {
		max-width: 34rem;
	}

	.split-grid--text-right .split-text {
		grid-column: 2;
		grid-row: 1;
		padding-left: clamp(2rem, 6vw, 5rem);
	}

	.split-grid--text-left .split-text {
		grid-column: 1;
		grid-row: 1;
		padding-right: clamp(2rem, 6vw, 5rem);
	}

	.split-grid--text-right .split-open {
		grid-column: 1;
		grid-row: 1;
	}

	.split-open {
		pointer-events: none;
	}

	.split-text .lead {
		margin-bottom: 1.75rem;
	}

	@media (max-width: 820px) {
		.split-grid {
			grid-template-columns: 1fr;
			min-height: 0;
			gap: 0;
		}

		.split-text {
			max-width: none;
			padding-inline: 0;
			order: -1;
		}

		/* Reserve clear space below the text so the centered
		   particle formation gets its own room on small screens. */
		.split-open {
			min-height: 85vw;
		}
	}
</style>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (prefersReduced) {
		gsap.set('[data-anim]', { opacity: 1, clearProps: 'transform' });
	} else {
		gsap.utils.toArray<HTMLElement>('.split-text[data-anim]').forEach((el) => {
			gsap.fromTo(
				el,
				{ y: 24 },
				{
					opacity: 1,
					y: 0,
					duration: 0.6,
					ease: 'power3.out',
					scrollTrigger: { trigger: el, start: 'top 80%' },
				},
			);
		});

		gsap.utils.toArray<HTMLElement>('[data-cta]').forEach((btn) => {
			const hov = gsap.timeline({ paused: true });
			hov.to(btn, { y: -3, scale: 1.02, duration: 0.25, ease: 'power2.out' });
			btn.addEventListener('mouseenter', () => hov.play());
			btn.addEventListener('mouseleave', () => hov.reverse());
		});
	}
</script>
