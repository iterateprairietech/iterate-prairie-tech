---
interface Props {
	label?: string;
	ratio?: string;
	class?: string;
}

const { label = 'Photo placeholder', ratio = '4 / 3', class: className = '' } = Astro.props;
---

<figure class:list={['photo-ph', className]} style={`--ratio: ${ratio}`}>
	<div class="photo-ph__inner">
		<svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
			<rect x="3" y="4" width="18" height="16" rx="2" />
			<circle cx="9" cy="10" r="1.6" />
			<path d="m3 17 5-4 4 3 3-2 6 5" stroke-linecap="round" stroke-linejoin="round" />
		</svg>
		<span>{label}</span>
	</div>
</figure>

<style>
	.photo-ph {
		margin: 0;
		border-radius: var(--radius);
		overflow: hidden;
		background: var(--bg-2);
		border: 1px solid var(--border);
	}

	.photo-ph__inner {
		aspect-ratio: var(--ratio);
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.65rem;
		color: var(--muted);
	}

	.photo-ph__inner span {
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}
</style>
