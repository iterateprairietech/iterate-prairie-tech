---
interface NavLink {
	label: string;
	href: string;
}

const links: NavLink[] = [
	{ label: 'Home', href: '/' },
	{ label: 'About', href: '/about' },
	{ label: 'Services', href: '/services' },
];

const { activePath = '/' } = Astro.props;
---

<header class="site-nav" data-nav>
	<div class="container nav-inner">
		<a class="brand" href="/" aria-label="Iterate Prairie Tech home">
			<img src="/Iterate Prairie Tech (Header) (675px by 100px).png" alt="Iterate Prairie Tech" width="675" height="100" />
		</a>

		<nav class="nav-links" data-nav-links>
			{
				links.map((l) => (
					<a
						class:list={['nav-link', { 'is-active': activePath === l.href }]}
						href={l.href}
						aria-current={activePath === l.href ? 'page' : undefined}
						data-nav-link
					>
						<span class="nav-link__label">{l.label}</span>
						<span class="nav-link__underline" aria-hidden="true"></span>
					</a>
				))
			}
			<a class="btn btn-primary nav-cta" href="/contact" data-nav-cta>Get in Touch</a>
		</nav>

		<button class="nav-toggle" data-nav-toggle aria-label="Toggle menu" aria-expanded="false">
			<span></span>
			<span></span>
			<span></span>
		</button>
	</div>
</header>

<style>
	.site-nav {
		position: fixed;
		inset: 0 0 auto 0;
		z-index: 100;
		height: var(--nav-h);
		display: flex;
		align-items: center;
		background: rgba(242, 239, 235, 0);
		backdrop-filter: blur(0);
		border-bottom: 1px solid transparent;
		transition:
			background 0.3s ease,
			backdrop-filter 0.3s ease,
			border-color 0.3s ease;
	}

	.site-nav.is-scrolled {
		background: rgba(242, 239, 235, 0.82);
		backdrop-filter: blur(14px);
		border-bottom: 1px solid var(--border);
	}

	.nav-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.brand {
		display: inline-flex;
		align-items: center;
	}

	.brand img {
		height: 4rem;
		width: auto;
		border-radius: 0;
		object-fit: contain;
		background: transparent;
		border: none;
		transition: transform 0.25s ease;
	}

	.brand:hover img {
		transform: scale(1.05);
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 0.35rem;
	}

	.nav-link {
		position: relative;
		display: inline-flex;
		padding: 0.5rem 0.85rem;
		color: var(--text);
		font-family: Sora, Inter, sans-serif;
		font-size: 0.9rem;
		font-weight: 600;
		transition: color 0.25s ease;
	}

	.nav-link.is-active {
		color: var(--accent);
	}

	.nav-link__underline {
		position: absolute;
		left: 0.85rem;
		right: 0.85rem;
		bottom: 0.3rem;
		height: 2px;
		border-radius: 2px;
		background: var(--accent-grad);
		transform: scaleX(0);
		transform-origin: left center;
	}

	.nav-link.is-active .nav-link__underline {
		transform: scaleX(1);
	}

	.nav-cta {
		margin-left: 0.5rem;
		padding: 0.55rem 1.1rem;
		font-size: 0.85rem;
	}

	.nav-toggle {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 5px;
		width: 42px;
		height: 42px;
		padding: 0;
		background: transparent;
		border: 1px solid var(--border);
		border-radius: 10px;
	}

	.nav-toggle span {
		display: block;
		width: 18px;
		height: 2px;
		margin-inline: auto;
		background: var(--text);
		border-radius: 2px;
	}

	@media (max-width: 880px) {
		.nav-toggle {
			display: flex;
		}

		.nav-links {
			position: absolute;
			top: var(--nav-h);
			left: 0;
			right: 0;
			flex-direction: column;
			align-items: stretch;
			gap: 0;
			padding: 0.75rem 1.5rem 1.5rem;
			background: rgba(242, 239, 235, 0.97);
			backdrop-filter: blur(14px);
			border-bottom: 1px solid var(--border);
			opacity: 0;
			pointer-events: none;
			transition: opacity 0.25s ease;
		}

		.site-nav.is-open .nav-links {
			opacity: 1;
			pointer-events: auto;
		}

		.nav-link {
			padding: 0.9rem 0.25rem;
			border-bottom: 1px solid var(--border);
		}

		.nav-link__underline {
			display: none;
		}

		.nav-cta {
			margin: 1rem 0 0;
			align-self: flex-start;
		}
	}
</style>

<script>
	import gsap from 'gsap';

	const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const nav = document.querySelector<HTMLElement>('[data-nav]');
	const navLinks = gsap.utils.toArray<HTMLElement>('[data-nav-link]');
	const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
	const lines = toggle ? Array.from(toggle.querySelectorAll('span')) : [];

	if (nav) {
		const onScroll = () => nav.classList.toggle('is-scrolled', window.scrollY > 8);
		window.addEventListener('scroll', onScroll, { passive: true });
		onScroll();
	}

	navLinks.forEach((link) => {
		const underline = link.querySelector<HTMLElement>('.nav-link__underline');
		const isActive = link.classList.contains('is-active');
		if (underline && !prefersReduced && !isActive) {
			const tl = gsap.timeline({ paused: true });
			tl.to(underline, { scaleX: 1, duration: 0.35, ease: 'power3.out' }).to(
				link,
				{ color: '#FF7870', duration: 0.35 },
				0,
			);
			link.addEventListener('mouseenter', () => tl.play());
			link.addEventListener('mouseleave', () => tl.reverse());
		}
	});

	let menuOpen = false;
	function setMenu(open: boolean) {
		menuOpen = open;
		nav?.classList.toggle('is-open', open);
		toggle?.setAttribute('aria-expanded', String(open));
		if (toggle && !prefersReduced) {
			gsap.to(lines[0], { y: open ? 7 : 0, rotation: open ? 45 : 0, duration: 0.3, ease: 'power2.inOut' });
			gsap.to(lines[1], { opacity: open ? 0 : 1, duration: 0.2 });
			gsap.to(lines[2], { y: open ? -7 : 0, rotation: open ? -45 : 0, duration: 0.3, ease: 'power2.inOut' });
		}
	}
	toggle?.addEventListener('click', () => setMenu(!menuOpen));
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && menuOpen) setMenu(false);
	});
	navLinks.forEach((l) => l.addEventListener('click', () => menuOpen && setMenu(false)));

	if (nav && !prefersReduced) {
		gsap.from(nav, { y: -40, opacity: 0, duration: 0.8, ease: 'power3.out', delay: 0.15 });
	}
</script>
