---
const headline = ['Built', 'for', "what's", 'now.', 'Ready', 'for', "what's", 'next.'];
---

<section id="home" class="hero" data-hero>
	<div class="container hero-content">
		<h1 class="hero-title">
			{
				headline.map((word) => (
					<span class="word-mask">
						<span class="word" data-anim data-hero-word>
							{word}
						</span>
					</span>
				))
			}
		</h1>

		<p class="hero-sub" data-anim data-hero-sub>
			Small business websites and tech support around Breckenridge, from one person who doesn't
			disappear once the invoice is paid.
		</p>

		<div class="hero-cta" data-hero-cta>
			<a class="btn btn-primary" href="/contact" data-cta>Get in Touch</a>
			<a class="btn btn-ghost" href="/services" data-cta>See services</a>
		</div>
	</div>

	<a class="scroll-cue" href="#services-preview" data-anim data-scrollcue aria-label="Scroll to services">
		<span class="scroll-cue__dot"></span>
	</a>

	<div class="click-cue" data-anim data-clickcue aria-hidden="true">
		<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
			<path d="M5 3l14 8-6.5 1.5L9 19 5 3z" stroke-linejoin="round" />
		</svg>
		<span>Click or tap the background</span>
	</div>
</section>

<style>
	.hero {
		position: relative;
		min-height: 100vh;
		display: flex;
		align-items: center;
		padding-top: calc(var(--nav-h) + 2rem);
		overflow: hidden;
		background: transparent;
		color: #F2EFEB;
	}

	.hero-content {
		position: relative;
		z-index: 1;
		max-width: 60rem;
	}

	.hero-title {
		font-size: clamp(2.4rem, 6vw, 4.6rem);
		text-transform: uppercase;
		line-height: 1.04;
		margin-bottom: 1.5rem;
		color: #F2EFEB;
	}

	.word-mask {
		display: inline-block;
		overflow: hidden;
		vertical-align: top;
		margin-right: 0.28em;
	}

	.word-mask:last-child {
		margin-right: 0;
	}

	.word {
		display: inline-block;
		will-change: transform;
	}

	.hero-sub {
		color: rgba(242, 239, 235, 0.72);
		font-size: clamp(1.05rem, 1.4vw, 1.25rem);
		max-width: 40rem;
		margin-bottom: 2.25rem;
	}

	.hero :global(.btn-ghost) {
		color: #F2EFEB;
		border-color: rgba(242, 239, 235, 0.28);
	}

	.hero-cta {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
	}

	.scroll-cue {
		position: absolute;
		bottom: 1.75rem;
		left: 50%;
		transform: translateX(-50%);
		z-index: 1;
		width: 26px;
		height: 42px;
		border: 1px solid rgba(242, 239, 235, 0.28);
		border-radius: 14px;
		display: flex;
		justify-content: center;
		padding-top: 7px;
	}

	.scroll-cue__dot {
		width: 4px;
		height: 8px;
		border-radius: 2px;
		background: var(--accent);
	}

	.click-cue {
		position: absolute;
		bottom: 1.75rem;
		left: 2rem;
		z-index: 1;
		display: flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.5rem 0.9rem;
		border: 1px solid rgba(242, 239, 235, 0.28);
		border-radius: 999px;
		color: rgba(242, 239, 235, 0.72);
		font-family: Sora, Inter, sans-serif;
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		pointer-events: none;
	}

	.click-cue svg {
		flex: none;
		color: var(--accent);
	}

	@media (max-width: 640px) {
		.scroll-cue {
			display: none;
		}

		.click-cue {
			left: 50%;
			transform: translateX(-50%);
			white-space: nowrap;
		}
	}
</style>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const words = gsap.utils.toArray<HTMLElement>('[data-hero-word]');

	const hero = document.querySelector<HTMLElement>('[data-hero]');
	hero?.addEventListener('click', (e) => {
		if (prefersReduced) return;
		const t = e.target as Element | null;
		if (t?.closest('a, button')) return;
		window.dispatchEvent(
			new CustomEvent('ipt:heroburst', { detail: { x: e.clientX, y: e.clientY } }),
		);
	});

	if (prefersReduced) {
		gsap.set('[data-anim]', { opacity: 1, y: 0, yPercent: 0, clearProps: 'transform' });
	} else {
		const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });
		tl.fromTo(
				words,
				{ yPercent: 115 },
				{ opacity: 1, yPercent: 0, duration: 0.85, stagger: 0.07 },
			)
			.fromTo('[data-hero-sub]', { y: 18 }, { opacity: 1, y: 0, duration: 0.6 }, '-=0.45')
			.fromTo(
				'[data-hero-cta] > *',
				{ y: 14 },
				{ opacity: 1, y: 0, duration: 0.5, stagger: 0.09 },
				'-=0.35',
			)
			.fromTo('[data-scrollcue]', {}, { opacity: 1, duration: 0.5 }, '-=0.2')
			.fromTo('[data-clickcue]', {}, { opacity: 1, duration: 0.5 }, '-=0.3');

		gsap.to('.hero-content', {
			y: -50,
			opacity: 0.3,
			ease: 'none',
			scrollTrigger: { trigger: '.hero', start: 'top top', end: 'bottom top', scrub: true },
		});

		gsap.to('.scroll-cue__dot', {
			y: 12,
			opacity: 0.3,
			duration: 1.1,
			repeat: -1,
			yoyo: true,
			ease: 'power1.inOut',
		});
	}
</script>
