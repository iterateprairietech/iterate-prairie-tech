---
interface Props {
	name?: string;
	text?: string;
	href?: string;
	image?: string;
}

const { name, text, href, image } = Astro.props;

function visualFromLink(url: string): string {
	if (/\.(png|jpe?g|gif|svg|webp)(\?|$)/i.test(url)) return url;
	return `https://api.microlink.io/?url=${encodeURIComponent(url)}&screenshot=true&meta=false&embed=screenshot.url`;
}

const visual = image ?? (href ? visualFromLink(href) : undefined);
---

<article class="project-card" data-anim data-card>
	{
		href ? (
			<a class="project-card__hit" href={href} target="_blank" rel="noopener noreferrer">
				<div class="project-card__visual">
					<slot name="visual">{visual ? <img src={visual} alt="" /> : null}</slot>
				</div>
				<div class="project-card__body">
					{name ? <h3>{name}</h3> : null}
					{text ? <p>{text}</p> : null}
				</div>
			</a>
		) : (
			<>
				<div class="project-card__visual">
					<slot name="visual">{visual ? <img src={visual} alt="" /> : null}</slot>
				</div>
				<div class="project-card__body">
					{name ? <h3>{name}</h3> : null}
					{text ? <p>{text}</p> : null}
				</div>
			</>
		)
	}
</article>

<style>
	.project-card {
		display: flex;
		flex-direction: column;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		overflow: hidden;
	}

	.project-card__hit {
		display: flex;
		flex-direction: column;
		flex: 1;
		color: inherit;
	}

	.project-card__visual {
		position: relative;
		aspect-ratio: 16 / 9;
		background: #2c2c2a;
		overflow: hidden;
	}

	.project-card__visual :global(img),
	.project-card__visual :global(canvas) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		display: block;
		object-fit: cover;
		pointer-events: none;
	}

	.project-card__body {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.35rem;
		min-height: 5.5rem;
		padding: 1.15rem 1.35rem 1.35rem;
	}

	.project-card__body h3 {
		font-size: 1.15rem;
		text-transform: uppercase;
	}

	.project-card__body p {
		color: var(--muted);
		margin: 0;
	}
</style>
