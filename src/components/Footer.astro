---
const year = new Date().getFullYear();
---

<footer class="site-foot" data-footer>
	<div class="container">
		<div class="foot-main">
			<div class="foot-id">
				<a class="foot-brand" href="/" aria-label="Iterate Prairie Tech home">
					<img src="/Iterate_Prairie_Tech.png" alt="Iterate Prairie Tech" width="56" height="56" />
				</a>
				<p class="tagline">Built for what's now. Ready for what's next.</p>
			</div>
			<div class="foot-contact">
				<a href="mailto:contact@iterateprairietech.com">contact@iterateprairietech.com</a>
				<span>Breckenridge, MN and the surrounding area</span>
			</div>
		</div>

		<div class="foot-bottom">
			<span>&copy; {year} Iterate Prairie Tech. All rights reserved.</span>
			<span class="foot-built">Built with Astro &middot; GSAP &middot; Lenis</span>
		</div>
	</div>
</footer>

<style>
	.site-foot {
		background: var(--text);
		color: #E9E5DF;
		padding: 3rem 0 1.75rem;
		margin-top: 4rem;
	}

	.foot-main {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
		flex-wrap: wrap;
	}

	.foot-id {
		display: flex;
		align-items: center;
		gap: 1.25rem;
	}

	.foot-brand img {
		height: 5rem;
		width: 5rem;
		border-radius: 14px;
		object-fit: cover;
		background: #F2EFEB;
		border: 1px solid rgba(255, 255, 255, 0.15);
		transition: transform 0.25s ease;
	}

	.foot-brand:hover img {
		transform: scale(1.05);
	}

	.tagline {
		font-family: Sora, Inter, sans-serif;
		font-weight: 700;
		font-size: clamp(1rem, 2.2vw, 1.2rem);
		letter-spacing: 0.01em;
		color: #fff;
		margin: 0;
	}

	.foot-contact {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 0.4rem;
		font-size: 0.95rem;
		text-align: right;
	}

	.foot-contact a {
		color: var(--accent-2);
	}

	.foot-contact a:hover {
		color: #fff;
	}

	.foot-contact span {
		color: #9B9892;
	}

	.foot-bottom {
		display: flex;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 2.25rem;
		padding-top: 1.5rem;
		border-top: 1px solid rgba(255, 255, 255, 0.1);
		font-size: 0.84rem;
		color: #9B9892;
	}

	.foot-built {
		color: #6B6862;
	}

	@media (max-width: 760px) {
		.foot-contact {
			align-items: flex-start;
			text-align: left;
		}

		.foot-bottom {
			flex-direction: column;
			align-items: center;
			text-align: center;
		}
	}
</style>
