---
const year = new Date().getFullYear();
---

<footer class="site-foot" data-footer>
	<div class="container">
		<div class="foot-top">
			<a class="foot-brand" href="/" aria-label="Iterate Prairie Tech home">
				<img src="/Iterate_Prairie_Tech.png" alt="Iterate Prairie Tech" width="56" height="56" />
			</a>

			<p class="tagline">Built for what's now. Ready for what's next.</p>

			<nav class="foot-nav" aria-label="Footer">
				<a href="/">Home</a>
				<a href="/about">About</a>
				<a href="/services">Services</a>
				<a href="/contact">Contact</a>
			</nav>
		</div>

		<div class="foot-contact">
			<a href="mailto:contact@iterateprairietech.com">contact@iterateprairietech.com</a>
			<span>Breckenridge, MN and the surrounding area</span>
		</div>

		<div class="foot-bottom">
			<span>&copy; {year} Iterate Prairie Tech. All rights reserved.</span>
			<span class="foot-built">Built with Astro &middot; GSAP &middot; Lenis</span>
		</div>
	</div>
</footer>

<style>
	.site-foot {
		background: var(--text);
		color: #E9E5DF;
		padding: 3.25rem 0 2rem;
		margin-top: 4rem;
	}

	.foot-top {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 2rem;
		padding-bottom: 2.5rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
	}

	.foot-brand {
		display: inline-flex;
		align-items: center;
		justify-self: start;
	}

	.foot-brand img {
		height: 7rem;
		width: 7rem;
		border-radius: 16px;
		object-fit: cover;
		background: #F2EFEB;
		border: 1px solid rgba(255, 255, 255, 0.15);
		transition: transform 0.25s ease;
	}

	.foot-brand:hover img {
		transform: scale(1.05);
	}

	.tagline {
		font-family: Sora, Inter, sans-serif;
		font-weight: 700;
		font-size: clamp(1rem, 2.2vw, 1.3rem);
		letter-spacing: 0.01em;
		color: #fff;
		text-align: center;
	}

	.foot-nav {
		display: flex;
		gap: 1.25rem;
		justify-self: end;
	}

	.foot-nav a {
		color: #C9C5BF;
		font-size: 0.92rem;
		font-weight: 500;
	}

	.foot-nav a:hover {
		color: var(--accent-2);
	}

	.foot-contact {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
		padding: 1.75rem 0;
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
		font-size: 0.95rem;
	}

	.foot-contact a {
		color: var(--accent-2);
	}

	.foot-contact a:hover {
		color: #fff;
	}

	.foot-contact span {
		color: #9B9892;
	}

	.foot-bottom {
		display: flex;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 1.5rem;
		font-size: 0.84rem;
		color: #9B9892;
	}

	.foot-built {
		color: #6B6862;
	}

	@media (max-width: 760px) {
		.foot-top {
			grid-template-columns: 1fr;
			text-align: center;
			gap: 1.5rem;
		}

		.foot-brand,
		.foot-nav {
			justify-self: center;
		}

		.foot-nav {
			flex-wrap: wrap;
			justify-content: center;
		}

		.foot-contact {
			flex-direction: column;
			gap: 0.75rem;
		}

		.foot-bottom {
			flex-direction: column;
			align-items: center;
			text-align: center;
		}
	}
</style>
