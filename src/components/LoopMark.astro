---
interface Props {
	size?: number;
	class?: string;
}

const { size = 64, class: className = '' } = Astro.props;
---

<img
	class:list={['loop-mark', className]}
	data-loop-mark
	src="/Iterate Prairie Tech Loop No BG.png"
	alt=""
	width={size}
	height={size}
	style={`width:${size}px;height:${size}px;object-fit:contain;`}
/>

<style>
	.loop-mark {
		display: block;
		will-change: transform;
	}
</style>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const marks = gsap.utils.toArray<HTMLElement>('[data-loop-mark]');

	marks.forEach((mark) => {
		if (prefersReduced) {
			gsap.set(mark, { opacity: 1, rotation: 0, clearProps: 'transform' });
			return;
		}
		gsap.fromTo(
			mark,
			{ rotation: -90, opacity: 0 },
			{
				rotation: 0,
				opacity: 1,
				duration: 1,
				ease: 'power3.out',
				scrollTrigger: { trigger: mark, start: 'top 88%', once: true },
			},
		);
	});
</script>
