---
interface Props {
	title?: string;
	text?: string;
}

const {
	title = 'Have a project in mind?',
	text = "Website or tech support, email me and I'll sort out next steps.",
} = Astro.props;
---

<section class="cta-band" data-cta-band>
	<div class="container">
		<div class="cta-inner" data-anim>
			<div class="cta-text">
				<h2>{title}</h2>
				<p>{text}</p>
			</div>
			<a class="btn btn-primary" href="/contact" data-cta>Get in Touch</a>
		</div>
	</div>
</section>

<style>
	.cta-band {
		padding: 3rem 0;
	}

	.cta-inner {
		display: flex;
		align-items: center;
		gap: 2rem;
		flex-wrap: wrap;
		padding: 3rem;
		background:
			radial-gradient(110% 110% at 0% 0%, rgba(255, 120, 112, 0.12), transparent 55%),
			radial-gradient(110% 110% at 100% 100%, rgba(56, 182, 255, 0.08), transparent 55%),
			var(--surface);
		border: 1px solid var(--border);
		border-radius: 20px;
	}

	.cta-text {
		flex: 1;
		min-width: 220px;
	}

	.cta-text h2 {
		font-size: 1.6rem;
		text-transform: uppercase;
		margin-bottom: 0.5rem;
	}

	.cta-text p {
		color: var(--muted);
	}

	.cta-inner .btn {
		margin-left: auto;
	}

	@media (max-width: 640px) {
		.cta-inner {
			padding: 2rem;
			flex-direction: column;
			text-align: center;
		}

		.cta-inner .btn {
			margin-left: 0;
		}
	}
</style>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (prefersReduced) {
		gsap.set('[data-anim]', { opacity: 1, clearProps: 'transform' });
	} else {
		gsap.fromTo(
			'[data-cta-band] .cta-inner',
			{ y: 26 },
			{
				opacity: 1,
				y: 0,
				duration: 0.7,
				ease: 'power3.out',
				scrollTrigger: { trigger: '[data-cta-band]', start: 'top 85%' },
			},
		);

		const btn = document.querySelector<HTMLElement>('[data-cta]');
		if (btn) {
			const hov = gsap.timeline({ paused: true });
			hov.to(btn, { y: -3, scale: 1.02, duration: 0.25, ease: 'power2.out' });
			btn.addEventListener('mouseenter', () => hov.play());
			btn.addEventListener('mouseleave', () => hov.reverse());
		}
	}
</script>
