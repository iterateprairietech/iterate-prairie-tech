---
const year = new Date().getFullYear();
---

<section id="contact" class="section contact" data-contact>
	<div class="container">
		<div class="panel" data-anim data-panel>
			<div class="panel-text">
				<p class="kicker" data-anim data-ck>Get in touch</p>
				<h2 class="panel-title" data-anim data-pt>Have a project in mind?</h2>
				<p class="panel-sub" data-anim data-ps>
					Tell us what you’re building. We’ll get back within two business days with
					next steps and a rough timeline.
				</p>
			</div>
			<a class="btn btn-primary" href="mailto:hello@iterate-prairie.tech" data-anim data-cta>
				hello@iterate-prairie.tech
			</a>
		</div>

		<footer class="site-foot">
			<span>&copy; {year} Iterate Prairie Tech</span>
			<span class="foot-meta">Built with Astro · GSAP · Lenis</span>
		</footer>
	</div>
</section>

<style>
	.contact {
		background: linear-gradient(180deg, var(--bg) 0%, var(--surface) 100%);
	}

	.panel {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
		flex-wrap: wrap;
		padding: 3.25rem;
		background:
			radial-gradient(120% 120% at 0% 0%, rgba(124, 92, 255, 0.16), transparent 55%),
			radial-gradient(120% 120% at 100% 100%, rgba(0, 212, 255, 0.12), transparent 55%),
			var(--surface-2);
		border: 1px solid var(--border);
		border-radius: 20px;
		max-width: var(--maxw);
	}

	.kicker {
		color: var(--accent-2);
		font-size: 0.85rem;
		font-weight: 600;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		margin-bottom: 0.85rem;
	}

	.panel-title {
		font-size: clamp(1.6rem, 3.4vw, 2.4rem);
		margin-bottom: 0.75rem;
	}

	.panel-sub {
		color: var(--muted);
		font-size: 1.02rem;
		max-width: 34rem;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		padding: 0.95rem 1.5rem;
		border-radius: 12px;
		font-weight: 600;
		font-size: 0.97rem;
		border: 1px solid transparent;
		background: var(--accent-grad);
		color: #0b0c12;
		box-shadow: 0 10px 30px -10px rgba(124, 92, 255, 0.6);
		will-change: transform;
	}

	.site-foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 3rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--border);
		color: var(--muted);
		font-size: 0.88rem;
	}

	:global(html.js) [data-anim] {
		opacity: 0;
	}

	@media (max-width: 640px) {
		.panel {
			padding: 2rem;
		}
	}
</style>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const panel = document.querySelector('[data-panel]');

	if (prefersReduced) {
		gsap.set('[data-anim]', { opacity: 1, y: 0, clearProps: 'transform' });
	} else {
		const trig = { trigger: '[data-contact]', start: 'top 80%' };
		gsap.fromTo('[data-panel]', { y: 26 }, { opacity: 1, y: 0, duration: 0.7, ease: 'power3.out', scrollTrigger: trig });

		const kids = ['[data-ck]', '[data-pt]', '[data-ps]', '[data-cta]'];
		kids.forEach((sel, i) => {
			gsap.fromTo(
				sel,
				{ y: 16 },
				{ opacity: 1, y: 0, duration: 0.55, delay: i * 0.08, ease: 'power3.out', scrollTrigger: trig },
			);
		});

		const btn = document.querySelector<HTMLElement>('[data-cta]');
		if (btn) {
			const hov = gsap.timeline({ paused: true });
			hov.to(btn, { y: -3, scale: 1.02, duration: 0.25, ease: 'power2.out' });
			btn.addEventListener('mouseenter', () => hov.play());
			btn.addEventListener('mouseleave', () => hov.reverse());
		}
	}
</script>
