---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Iterate Prairie Tech',
	description = 'Iterate Prairie Tech — building fast, considered web experiences.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
		/>
		<title>{title}</title>
		<script is:inline>
			// Mark JS as active before paint so [data-anim] elements can hide until animated.
			document.documentElement.classList.add('js');
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import Lenis from 'lenis';

	gsap.registerPlugin(ScrollTrigger);

	const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	let lenis: Lenis | null = null;

	if (!prefersReduced) {
		lenis = new Lenis({
			duration: 1.1,
			easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
			smoothWheel: true,
			wheelMultiplier: 1,
			touchMultiplier: 1.5,
		});

		lenis.on('scroll', ScrollTrigger.update);

		gsap.ticker.add((time) => {
			lenis?.raf(time * 1000);
		});
		gsap.ticker.lagSmoothing(0);
	}

	// Centralized anchor scrolling so components can request smooth scroll without
	// reaching into Lenis directly. Falls back to native behavior when Lenis is off.
	const NAV_OFFSET = 72; // matches --nav-h in px
	window.addEventListener('ipt:scrollto', ((e: Event) => {
		const detail = (e as CustomEvent<string | HTMLElement>).detail;
		const target =
			typeof detail === 'string' ? document.querySelector(detail) : detail;
		if (!(target instanceof HTMLElement)) return;
		if (lenis) {
			lenis.scrollTo(target, { offset: -NAV_OFFSET });
		} else {
			target.scrollIntoView({
				behavior: prefersReduced ? 'auto' : 'smooth',
				block: 'start',
			});
		}
	}) as EventListener);

	// Global in-page anchor delegation: any <a href="#..."> scrolls smoothly via
	// Lenis, with a native fallback. Lets components use plain anchors.
	document.addEventListener('click', ((e: MouseEvent) => {
		const a = (e.target as Element | null)?.closest?.('a[href^="#"]');
		if (!(a instanceof HTMLAnchorElement)) return;
		const href = a.getAttribute('href');
		if (!href || href === '#') return;
		const target = document.querySelector(href);
		if (!target) return;
		e.preventDefault();
		window.dispatchEvent(new CustomEvent('ipt:scrollto', { detail: href }));
		history.replaceState(null, '', href);
	}) as EventListener);

	// Recompute triggers once everything (fonts/images) settles.
	window.addEventListener('load', () => ScrollTrigger.refresh());
</script>
