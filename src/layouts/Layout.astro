---
import '../styles/global.css';
import ParticleBackground from '../components/ParticleBackground.astro';

interface Props {
	title?: string;
	description?: string;
	activePath?: string;
}

const {
	title = 'Iterate Prairie Tech',
	description = 'Local web development and IT support for small businesses around Breckenridge, MN.',
	activePath = '/',
} = Astro.props;

const siteName = 'Iterate Prairie Tech';
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;
---

<!doctype html>
<html lang="en" class={activePath === '/' ? 'is-home' : undefined}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/Iterate Prairie Tech - Favicon.png" />
		<link rel="apple-touch-icon" href="/Iterate Prairie Tech - Favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@600;700;800&display=swap"
		/>
		<title>{fullTitle}</title>
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>
	</head>
	<body>
		<div class="bg-layer" aria-hidden="true" data-bg-layer>
			<ParticleBackground />
			<span class="bg-grain"></span>
		</div>
		<slot />
	</body>
</html>

<script>
	import gsap from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import Lenis from 'lenis';

	gsap.registerPlugin(ScrollTrigger);

	const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	let lenis: Lenis | null = null;

	if (!prefersReduced) {
		lenis = new Lenis({
			duration: 1.1,
			easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
			smoothWheel: true,
			wheelMultiplier: 1,
			touchMultiplier: 1.5,
		});

		lenis.on('scroll', ScrollTrigger.update);

		gsap.ticker.add((time) => {
			lenis?.raf(time * 1000);
		});
		gsap.ticker.lagSmoothing(0);

		// Subtle parallax on the global background layer as you scroll.
		const bgLayer = document.querySelector<HTMLElement>('[data-bg-layer]');

		if (bgLayer) {
			gsap.to(bgLayer, {
				yPercent: 12,
				ease: 'none',
				scrollTrigger: { trigger: document.body, start: 'top top', end: 'bottom bottom', scrub: 1 },
			});
		}
	}

	const NAV_OFFSET = 76;
	window.addEventListener('ipt:scrollto', ((e: Event) => {
		const detail = (e as CustomEvent<string | HTMLElement>).detail;
		const target =
			typeof detail === 'string' ? document.querySelector(detail) : detail;
		if (!(target instanceof HTMLElement)) return;
		if (lenis) {
			lenis.scrollTo(target, { offset: -NAV_OFFSET });
		} else {
			target.scrollIntoView({
				behavior: prefersReduced ? 'auto' : 'smooth',
				block: 'start',
			});
		}
	}) as EventListener);

	document.addEventListener('click', ((e: MouseEvent) => {
		const a = (e.target as Element | null)?.closest?.('a[href^="#"]');
		if (!(a instanceof HTMLAnchorElement)) return;
		const href = a.getAttribute('href');
		if (!href || href === '#') return;
		const target = document.querySelector(href);
		if (!target) return;
		e.preventDefault();
		window.dispatchEvent(new CustomEvent('ipt:scrollto', { detail: href }));
		history.replaceState(null, '', href);
	}) as EventListener);

	window.addEventListener('load', () => ScrollTrigger.refresh());
</script>
